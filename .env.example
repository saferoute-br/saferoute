# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA coloque valores aqui e NUNCA use o prefixo NEXT_PUBLIC_ em segredos.

# String de conexão Postgres do papel app_api, pelo pooler do Supabase em modo
# transação (porta 6543). Usada só pelo servidor Next.js (a partir do M3).
DATABASE_URL=

# Opcional: certificado raiz público do provedor do banco, em base64, quando ele
# usa autoridade certificadora própria. A conexão sempre verifica o certificado.
DATABASE_CA_CERT_B64=

# String de conexão usada pelo pipeline de dados para carga em lote (a partir do M1).
# Fica só no computador que roda o pipeline; não vai para a Vercel.
PIPELINE_DATABASE_URL=

# Pasta local com os dados brutos (SSP-SP, IBGE). Ver data/README.md.
SAFEROUTE_DATA_DIR=
